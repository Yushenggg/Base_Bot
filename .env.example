# Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=

# Admin Telegram User ID (for whitelist management)
AUTHORIZED_USER=
# Agent Configuration
OPENAI_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
DEFAULT_MODEL=

# Session Configuration
DEFAULT_IDLE_TIMEOUT_SECONDS=300

# Database Configuration
DATABASE_PATH=./telebasebot.db

# Auth: Fernet key for encrypting stored OAuth tokens at data/auth/*.json.enc
# Auto-generated on first run if left blank. Back up .env — losing this key
# invalidates every stored login (you'll have to re-authenticate to every provider).
AUTH_ENCRYPTION_KEY=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Application type: Desktop app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=console